+#[test]
+fn explicit_write_deny_remains_visible_without_write_dac() {
+    let target = tempfile::NamedTempFile::new().expect("temporary file");
+    let sid = LocalSid::from_string("S-1-5-21-10-20-30-40").expect("test SID");
+    assert!(unsafe { super::add_deny_write_ace(target.path(), sid.as_ptr()) }.unwrap());
+
+    with_read_control_only(target.path(), |_| {
+        assert!(
+            !unsafe { super::add_deny_write_ace(target.path(), sid.as_ptr()) }
+                .expect("existing explicit deny needs no DACL update")
+        );
+    });
+}
+
+#[test]
+fn inherited_write_deny_without_write_dac_requires_update() {
+    let parent = tempfile::tempdir().expect("temporary parent");
+    let sid = LocalSid::from_string("S-1-5-21-10-20-30-40").expect("test SID");
+    assert!(unsafe { super::add_deny_write_ace(parent.path(), sid.as_ptr()) }.unwrap());
+    let target = parent.path().join("target");
+    std::fs::write(&target, b"synthetic").expect("file inheriting the parent deny");
+
+    with_read_control_only(&target, |write_error| {
+        // Check the final raw ACE flags independently of the production no-op predicate.
+        unsafe {
+            let (dacl, descriptor) = fetch_dacl_handle(&target).unwrap();
+            let _descriptor = LocalAclAllocation(descriptor);
+            let mut found = false;
+            for index in 0..(*dacl).AceCount {
+                let mut ace = std::ptr::null_mut();
+                assert_ne!(super::GetAce(dacl, u32::from(index), &mut ace), 0);
+                let header = &*ace.cast::<super::ACE_HEADER>();
+                if header.AceType != super::ACCESS_DENIED_ACE_TYPE {
+                    continue;
+                }
+                let deny = &*ace.cast::<super::ACCESS_DENIED_ACE>();
+                if super::EqualSid(
+                    std::ptr::addr_of!(deny.SidStart).cast_mut().cast(),
+                    sid.as_ptr(),
+                ) == 0
+                {
+                    continue;
+                }
+                assert_ne!(header.AceFlags & super::INHERITED_ACE, 0);
+                assert_eq!(header.AceFlags & super::INHERIT_ONLY_ACE, 0);
+                assert_ne!(deny.Mask & super::FILE_WRITE_DATA, 0);
+                found = true;
+            }
+            assert!(
+                found,
+                "target has only inherited effective write denies for the SID"
+            );
+        }
+        let error = unsafe { super::add_deny_write_ace(&target, sid.as_ptr()) }
+            .expect_err("an inherited-only deny still requires an explicit target update");
+        assert_eq!(
+            error.to_string(),
+            "open deny ACL target for update (READ_CONTROL | WRITE_DAC)"
+        );
+        assert_eq!(
+            error
+                .downcast_ref::<std::io::Error>()
+                .unwrap()
+                .raw_os_error(),
+            write_error.raw_os_error()
+        );
+    });
+}
