+#[test]
+fn concurrent_policy_refreshes_preserve_scoped_root_grants() -> anyhow::Result<()> {
+    use crate::acl::add_deny_write_ace;
+    use crate::acl::dacl_has_write_deny_for_sid;
+    use crate::acl::fetch_dacl_handle;
+    use crate::cap::lock_write_policy_acls;
+    use crate::token::LocalSid;
+    use std::collections::HashSet;
+    use std::path::Path;
+    use std::sync::Barrier;
+
+    let temp = tempfile::tempdir()?;
+    let home = temp.path().join("codex-home");
+    let workspace = temp.path().join("workspace");
+    let legacy_path = workspace.join("legacy-protected");
+    fs::create_dir_all(&legacy_path)?;
+    let legacy = LocalSid::from_string(&workspace_write_cap_sid_for_root(
+        &home, &workspace, &workspace,
+    )?)?;
+    unsafe {
+        ensure_allow_write_aces(&workspace, &[legacy.as_ptr()])?;
+        add_deny_write_ace(&legacy_path, legacy.as_ptr())?;
+    }
+    let has_deny = |path: &Path, sid: &LocalSid| -> anyhow::Result<bool> {
+        unsafe {
+            let (dacl, descriptor) = fetch_dacl_handle(path)?;
+            let denied = dacl_has_write_deny_for_sid(dacl, sid.as_ptr());
+            LocalFree(descriptor as HLOCAL);
+            Ok(denied)
+        }
+    };
+    assert!(has_deny(&legacy_path, &legacy)?);
+
+    let barrier = Barrier::new(8);
+    let policies = std::thread::scope(|scope| {
+        let workers = (0..8)
+            .map(|index| {
+                let home = &home;
+                let workspace = &workspace;
+                let barrier = &barrier;
+                scope.spawn(move || -> anyhow::Result<_> {
+                    barrier.wait();
+                    let _acl_lock = lock_write_policy_acls(home)?;
+                    let protected = workspace.join(format!("policy-{index}-protected"));
+                    fs::create_dir(&protected)?;
+                    let sid_string = workspace_write_cap_sid_for_policy(
+                        home,
+                        workspace,
+                        std::slice::from_ref(&protected),
+                    )?;
+                    let sid = LocalSid::from_string(&sid_string)?;
+                    unsafe {
+                        ensure_allow_write_aces(workspace, &[sid.as_ptr()])?;
+                        add_deny_write_ace(&protected, sid.as_ptr())?;
+                    }
+                    Ok((protected, sid_string))
+                })
+            })
+            .collect::<Vec<_>>();
+        workers
+            .into_iter()
+            .map(|worker| worker.join().expect("ACL refresh worker"))
+            .collect::<anyhow::Result<Vec<_>>>()
+    })?;
+
+    assert_eq!(
+        policies
+            .iter()
+            .map(|(_, sid)| sid)
+            .collect::<HashSet<_>>()
+            .len(),
+        8,
+    );
+    for (protected, sid_string) in policies {
+        let sid = LocalSid::from_string(&sid_string)?;
+        assert!(path_mask_allows(
+            &workspace,
+            &[sid.as_ptr()],
+            FILE_GENERIC_WRITE,
+            /*require_all_bits*/ true,
+        )?);
+        assert!(has_deny(&protected, &sid)?);
+    }
+    assert!(has_deny(&legacy_path, &legacy)?);
+    Ok(())
+}
