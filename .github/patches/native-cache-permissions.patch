+/// Capability identities used by write policies must not share persistent deny ACEs.
+/// Keep this store separate from `cap_sid`: older binaries rewrite that legacy file.
+pub(crate) fn workspace_write_cap_sid_for_policy(
+    codex_home: &Path,
+    root: &Path,
+    deny_write_paths: &[PathBuf],
+) -> Result<String> {
+    let mut deny_keys: Vec<String> = deny_write_paths
+        .iter()
+        .map(|path| policy_path_key(path))
+        .collect();
+    deny_keys.sort();
+    deny_keys.dedup();
+    let key = serde_json::to_string(&(policy_path_key(root), deny_keys))?;
+    fs::create_dir_all(codex_home)
+        .with_context(|| format!("create capability directory {}", codex_home.display()))?;
+    let path = codex_home.join("write_policy_cap_sids");
+    let mut file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(&path)
+        .with_context(|| format!("open write policy capabilities {}", path.display()))?;
+    // Setup and token construction can run in different processes. Hold one file lock
+    // across allocation and persistence so both receive the same SID on first use.
+    file.lock()
+        .with_context(|| format!("lock write policy capabilities {}", path.display()))?;
+    let mut contents = String::new();
+    file.read_to_string(&mut contents)?;
+    let mut capabilities: HashMap<String, String> = if contents.is_empty() {
+        HashMap::new()
+    } else {
+        serde_json::from_str(&contents)
+            .with_context(|| format!("read write policy capabilities {}", path.display()))?
+    };
+    if let Some(sid) = capabilities.get(&key) {
+        return Ok(sid.clone());
+    }
+    let sid = make_random_cap_sid_string();
+    capabilities.insert(key, sid.clone());
+    let serialized = serde_json::to_vec(&capabilities)?;
+    file.seek(SeekFrom::Start(0))?;
+    file.write_all(&serialized)?;
+    file.set_len(serialized.len() as u64)?;
+    Ok(sid)
+}
+
+/// Serialize policy ACL refreshes that share the same capability namespace.
+/// SID allocation alone cannot prevent concurrent whole-DACL updates losing grants.
+pub(crate) fn lock_write_policy_acls(codex_home: &Path) -> Result<fs::File> {
+    fs::create_dir_all(codex_home)?;
+    let path = codex_home.join("write_policy_acl_lock");
+    let file = OpenOptions::new()
+        .read(true)
+        .write(true)
+        .create(true)
+        .truncate(false)
+        .open(&path)
+        .with_context(|| format!("open write policy ACL lock {}", path.display()))?;
+    file.lock()
+        .with_context(|| format!("lock write policy ACLs {}", path.display()))?;
+    Ok(file)
+}
+
+fn policy_path_key(path: &Path) -> String {
+    // Setup materializes missing carveouts. Resolve their existing ancestor now so
+    // their key stays the same after creation, including paths through junctions.
+    let mut ancestor = path;
+    let mut suffix = Vec::new();
+    loop {
+        if let Ok(mut canonical) = dunce::canonicalize(ancestor) {
+            for component in suffix.iter().rev() {
+                canonical.push(component);
+            }
+            return canonical_path_key(&canonical);
+        }
+        let (Some(parent), Some(name)) = (ancestor.parent(), ancestor.file_name()) else {
+            return canonical_path_key(path);
+        };
+        suffix.push(name);
+        ancestor = parent;
+    }
+}
