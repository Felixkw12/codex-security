+#[test]
+fn snapshot_capability_preserves_model_and_legacy_write_denies() -> anyhow::Result<()> {
+    use crate::acl::add_deny_write_ace;
+    use crate::acl::dacl_has_write_deny_for_sid;
+    use crate::acl::fetch_dacl_handle;
+    use crate::token::LocalSid;
+    use crate::token::create_workspace_write_token_with_caps_from;
+    use crate::token::get_current_token_for_restriction;
+    use crate::token::get_user_sid_bytes;
+    use anyhow::ensure;
+    use std::os::windows::io::AsRawHandle;
+    use std::os::windows::io::FromRawHandle;
+    use std::os::windows::io::OwnedHandle;
+    use windows_sys::Win32::Foundation::GetLastError;
+    use windows_sys::Win32::Security::AccessCheck;
+    use windows_sys::Win32::Security::DuplicateToken;
+    use windows_sys::Win32::Security::GENERIC_MAPPING;
+    use windows_sys::Win32::Security::InitializeSecurityDescriptor;
+    use windows_sys::Win32::Security::SECURITY_DESCRIPTOR;
+    use windows_sys::Win32::Security::SecurityImpersonation;
+    use windows_sys::Win32::Security::SetSecurityDescriptorDacl;
+    use windows_sys::Win32::Security::SetSecurityDescriptorGroup;
+    use windows_sys::Win32::Security::SetSecurityDescriptorOwner;
+    use windows_sys::Win32::Storage::FileSystem::FILE_ALL_ACCESS;
+    use windows_sys::Win32::Storage::FileSystem::FILE_WRITE_DATA;
+
+    let temp = tempfile::tempdir()?;
+    let home = temp.path().join("codex-home");
+    let workspace = temp.path().join("workspace");
+    let protected = workspace.join("cache-objects");
+    fs::create_dir_all(&protected)?;
+    let legacy = LocalSid::from_string(&workspace_write_cap_sid_for_root(
+        &home, &workspace, &workspace,
+    )?)?;
+    let model = LocalSid::from_string(&workspace_write_cap_sid_for_policy(
+        &home,
+        &workspace,
+        std::slice::from_ref(&protected),
+    )?)?;
+    let snapshot =
+        LocalSid::from_string(&workspace_write_cap_sid_for_policy(&home, &workspace, &[])?)?;
+
+    unsafe {
+        let base = OwnedHandle::from_raw_handle(get_current_token_for_restriction()? as _);
+        let token = |sid: &LocalSid| -> anyhow::Result<OwnedHandle> {
+            let primary =
+                OwnedHandle::from_raw_handle(create_workspace_write_token_with_caps_from(
+                    base.as_raw_handle() as _,
+                    &[sid.as_ptr()],
+                )? as _);
+            let mut impersonation = std::ptr::null_mut();
+            ensure!(
+                DuplicateToken(
+                    primary.as_raw_handle() as _,
+                    SecurityImpersonation,
+                    &mut impersonation,
+                ) != 0,
+                "DuplicateToken failed: {}",
+                GetLastError(),
+            );
+            Ok(OwnedHandle::from_raw_handle(impersonation as _))
+        };
+        ensure_allow_write_aces(&workspace, &[legacy.as_ptr()])?;
+        add_deny_write_ace(&protected, legacy.as_ptr())?;
+        let legacy_token = token(&legacy)?;
+        ensure_allow_write_aces(&workspace, &[model.as_ptr()])?;
+        add_deny_write_ace(&protected, model.as_ptr())?;
+        let model_token = token(&model)?;
+
+        // Keep both restricted tokens alive while the snapshot refresh adds its grant.
+        ensure_allow_write_aces(&workspace, &[snapshot.as_ptr()])?;
+        let snapshot_token = token(&snapshot)?;
+        let (dacl, original_descriptor) = fetch_dacl_handle(&protected)?;
+        let result = (|| -> anyhow::Result<()> {
+            assert!(dacl_has_write_deny_for_sid(dacl, legacy.as_ptr()));
+            assert!(dacl_has_write_deny_for_sid(dacl, model.as_ptr()));
+            assert!(!dacl_has_write_deny_for_sid(dacl, snapshot.as_ptr()));
+
+            let mut owner = get_user_sid_bytes(base.as_raw_handle() as _)?;
+            let mut descriptor: SECURITY_DESCRIPTOR = std::mem::zeroed();
+            let sd = std::ptr::addr_of_mut!(descriptor).cast();
+            ensure!(InitializeSecurityDescriptor(sd, 1) != 0);
+            ensure!(SetSecurityDescriptorOwner(sd, owner.as_mut_ptr().cast(), 0) != 0);
+            ensure!(SetSecurityDescriptorGroup(sd, owner.as_mut_ptr().cast(), 0) != 0);
+            ensure!(SetSecurityDescriptorDacl(sd, 1, dacl, 0) != 0);
+            let mapping = GENERIC_MAPPING {
+                GenericRead: FILE_GENERIC_READ,
+                GenericWrite: FILE_GENERIC_WRITE,
+                GenericExecute: FILE_GENERIC_EXECUTE,
+                GenericAll: FILE_ALL_ACCESS,
+            };
+            for (name, token, expected) in [
+                ("legacy", &legacy_token, false),
+                ("model", &model_token, false),
+                ("snapshot", &snapshot_token, true),
+            ] {
+                let mut privileges = [0u64; 128];
+                let mut privilege_bytes = std::mem::size_of_val(&privileges) as u32;
+                let mut granted = 0;
+                let mut allowed = 0;
+                ensure!(
+                    AccessCheck(
+                        sd,
+                        token.as_raw_handle() as _,
+                        FILE_WRITE_DATA,
+                        &mapping,
+                        privileges.as_mut_ptr().cast(),
+                        &mut privilege_bytes,
+                        &mut granted,
+                        &mut allowed,
+                    ) != 0,
+                    "AccessCheck({name}) failed: {}",
+                    GetLastError(),
+                );
+                assert_eq!(allowed != 0, expected, "{name} write access");
+            }
+            Ok(())
+        })();
+        LocalFree(original_descriptor as HLOCAL);
+        result?;
+    }
+    Ok(())
+}
