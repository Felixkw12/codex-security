+                FileSystemSandboxEntry::new(denied.clone().into(), FileSystemAccessMode::Read),
+                FileSystemSandboxEntry::new(denied.clone().into(), FileSystemAccessMode::Deny),
+                FileSystemSandboxEntry::new(allowed.clone().into(), FileSystemAccessMode::Read),
+            ];
+            if reverse {
+                entries.reverse();
+            }
+            for root_read in [false, true] {
+                let mut policy = if root_read {
+                    FileSystemSandboxPolicy::read_only()
+                } else {
+                    FileSystemSandboxPolicy::restricted(Vec::new())
+                };
+                policy.entries.extend(entries.clone());
+                assert_eq!(
+                    policy.get_explicit_readable_roots_with_cwd(tmp.path()),
+                    vec![normalize_effective_absolute_path(allowed.clone())]
+                );
